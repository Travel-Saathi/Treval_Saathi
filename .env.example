# Expo public variables.
# Only values intended for client exposure use the EXPO_PUBLIC_* prefix —
# they are baked into the shipped bundle by Metro.
# Never put private backend API keys here.

# Clerk (public publishable key, safe in the client bundle)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Supabase project URL + publishable/anon key (safe in the client bundle)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend base URL: http://localhost:5000 for local dev,
# https://YOUR_DEPLOYED_BACKEND_URL for production builds/APKs.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000