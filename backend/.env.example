# Backend (Express) environment.
# Copy to backend/.env and fill in real values. This file is committed to the
# repo for reference only; backend/.env must stay out of version control.
# Cloud hosts usually inject PORT automatically.

# Server port
PORT=5000

# Required third-party API keys
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_API_KEY
SERPER_API_KEY=YOUR_SERPER_API_KEY

# OSRM routing backend (default: public router.project-osrm.org)
# OSRM_SERVER=https://router.project-osrm.org

# Open-Meteo (default: https://api.open-meteo.com/v1/forecast)
# OPEN_METEO_BASE_URL=

# Web search provider
#   serper   -> hosted Serper.dev (recommended for production, needs SERPER_API_KEY)
#   openserp -> self-hosted OpenSERP (needs a running instance at OPEN_SERP_BASE_URL)
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_FALLBACK_PROVIDER=
OPEN_SERP_BASE_URL=http://127.0.0.1:7000

# mNTES Indian Railways (default: https://enquiry.indianrail.gov.in/mntes)
# NTES_BASE_URL=
# NTES_REQUEST_TIMEOUT_MS=15000

# Professional/conservative tuning for web search (Google-backed providers
# rate-limit bursts; these defaults serialize + pace + cache results)
WEB_SEARCH_CONCURRENCY=1
WEB_SEARCH_MIN_GAP_MS=1500
WEB_SEARCH_CACHE_TTL_MS=3600000
WEB_SEARCH_CACHE_MAX_ENTRIES=500
WEB_SEARCH_RATE_LIMIT_COOLDOWN_MS=30000
WEB_SEARCH_QUERY_TIMEOUT_MS=45000

# Railway search caching (ms)
RAILWAY_SEARCH_CACHE_TTL_MS=180000
RAILWAY_STATION_LIST_TTL_MS=86400000

# Route attractions search radius (km) around each route leg
# ROUTE_ATTRACTION_RADIUS_KM=