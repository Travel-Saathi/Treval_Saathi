GEOAPIFY_API_KEY=79cc14fd263d4ee3b64b89526ba35c24

PORT=5000

OSRM_SERVER=https://router.project-osrm.org

SERPER_API_KEY=fac34236720cf6345e753e399f5615de7ddfffce

WEB_SEARCH_PROVIDER=openserp
OPEN_SERP_BASE_URL=http://127.0.0.1:7000

# Google-backed search is rate-limited on bursts: serialized, paced, cached.
# Concurrency 1 = one upstream web-search call at a time across the whole backend.
WEB_SEARCH_CONCURRENCY=1
# Minimum gap between consecutive upstream provider calls (ms).
WEB_SEARCH_MIN_GAP_MS=1500
# Result cache TTL (ms): cached city+category searches never reach OpenSERP.
WEB_SEARCH_CACHE_TTL_MS=3600000
WEB_SEARCH_CACHE_MAX_ENTRIES=500
# Backoff after a provider returns 429/503 before it is skipped (ms).
WEB_SEARCH_RATE_LIMIT_COOLDOWN_MS=30000
# Per-query budget that also covers waiting in the serialization queue (ms).
WEB_SEARCH_QUERY_TIMEOUT_MS=45000